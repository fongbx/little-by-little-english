      "phrases": [
        {
          "en": "Where is the bus stop?",
          "zh": "公交车站在哪里？",
          "focus": "bus"
        },
        {
          "en": "I'd like one ticket, please.",
          "zh": "我想买一张票。",
          "focus": "ticket"
        },
        {
          "en": "Is the station on this street?",
          "zh": "车站在这条街上吗？",
          "focus": "station"
        },
        {
          "en": "Turn left here.",
          "zh": "在这里左转。",
          "focus": "left"
        },
        {
          "en": "Let’s take a taxi.",
          "zh": "我们坐出租车吧。",
          "focus": "taxi"
        },
        {
          "en": "Turn right at the next street.",
          "zh": "到下一条街向右转。",
          "focus": "right"
        },
        {
          "en": "The train leaves at six.",
          "zh": "火车六点出发。",
          "focus": "train"
        }
      ],
      "dialogue": [
        {
          "speaker": "A",
          "en": "Excuse me, where is the station?",
          "zh": "不好意思，请问车站在哪里？"
        },
        {
          "speaker": "B",
          "en": "Go straight. The train station is on the right.",
          "zh": "一直往前走。火车站在右边。"
        },
        {
          "speaker": "A",
          "en": "Can I take a taxi there?",
          "zh": "我可以坐出租车去那里吗？"
        },
        {
          "speaker": "B",
          "en": "Yes. The taxi stand is across the road.",
          "zh": "可以。出租车站在马路对面。"
        },
        {
          "speaker": "A",
          "en": "Thank you!",
          "zh": "谢谢！"
        },
        {
          "speaker": "B",
          "en": "You’re welcome.",
          "zh": "不客气。"
        }
      ]
    }
