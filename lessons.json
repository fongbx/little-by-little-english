    {
      "id": "cafe",
      "title": "At a café",
      "titleZh": "在咖啡店",
      "description": "Order a drink and ask for the bill",
      "wordIds": [
        "menu",
        "tea",
        "coffee",
        "water",
        "bill",
        "cup",
        "milk",
        "bread",
        "breakfast",
        "lunch"
      ],
      "phrases": [
        {
          "en": "Could I see the menu, please?",
          "zh": "可以让我看一下菜单吗？",
          "focus": "menu"
        },
        {
          "en": "I'd like a cup of tea, please.",
          "zh": "我想要一杯茶。",
          "focus": "tea"
        },
        {
          "en": "Could I have some water, please?",
          "zh": "可以给我一些水吗？",
          "focus": "water"
        },
        {
          "en": "Could we have the bill, please?",
          "zh": "麻烦给我们账单好吗？",
          "focus": "bill"
        },
        {
          "en": "Would you like milk in your tea?",
          "zh": "您的茶要加牛奶吗？",
          "focus": "milk"
        },
        {
          "en": "Could I have some bread, please?",
          "zh": "可以给我一些面包吗？",
          "focus": "bread"
        },
        {
          "en": "Let’s have lunch here.",
          "zh": "我们就在这里吃午饭吧。",
          "focus": "lunch"
        }
      ],
      "dialogue": [
        {
          "speaker": "A",
          "en": "What would you like for lunch?",
          "zh": "您午餐想吃什么？"
        },
        {
          "speaker": "B",
          "en": "Some bread and a cup of tea, please.",
          "zh": "请给我一些面包和一杯茶。"
        },
        {
          "speaker": "A",
          "en": "Would you like milk in your tea?",
          "zh": "您的茶要加牛奶吗？"
        },
        {
          "speaker": "B",
          "en": "Yes, please. Thank you.",
          "zh": "好的，谢谢。"
        },
        {
          "speaker": "A",
          "en": "Anything else?",
          "zh": "还需要别的吗？"
        },
        {
          "speaker": "B",
          "en": "No, thank you.",
          "zh": "不用了，谢谢。"
        }
      ]
    },
    {
