[
  {"id":"phrase-1","en":"Hello, how are you?","zh":"你好，你好吗？","scene":"朋友和交流"},
  {"id":"phrase-2","en":"I’m fine, thank you.","zh":"我很好，谢谢。","scene":"朋友和交流"},
  {"id":"phrase-3","en":"What is your name?","zh":"你叫什么名字？","scene":"朋友和交流"},
  {"id":"phrase-4","en":"My name is…","zh":"我叫……","scene":"朋友和交流"},
  {"id":"phrase-5","en":"Nice to meet you.","zh":"很高兴认识你。","scene":"朋友和交流"},
  {"id":"phrase-6","en":"Where are you from?","zh":"你来自哪里？","scene":"朋友和交流"},
  {"id":"phrase-7","en":"I’m from China.","zh":"我来自中国。","scene":"朋友和交流"},
  {"id":"phrase-8","en":"Could you speak more slowly?","zh":"你能说慢一点吗？","scene":"朋友和交流"},
  {"id":"phrase-9","en":"Could you say that again?","zh":"你能再说一遍吗？","scene":"朋友和交流"},
  {"id":"phrase-10","en":"I don’t understand.","zh":"我不明白。","scene":"朋友和交流"},
  {"id":"phrase-11","en":"I’m at home.","zh":"我在家。","scene":"家里和日常"},
  {"id":"phrase-12","en":"Please come in.","zh":"请进。","scene":"家里和日常"},
  {"id":"phrase-13","en":"Make yourself at home.","zh":"别客气，就当在自己家。","scene":"家里和日常"},
  {"id":"phrase-14","en":"Where is the bathroom?","zh":"卫生间在哪里？","scene":"家里和日常"},
  {"id":"phrase-15","en":"Please take off your shoes.","zh":"请脱鞋。","scene":"家里和日常"},
  {"id":"phrase-16","en":"I’ll make some tea.","zh":"我来泡点茶。","scene":"家里和日常"},
  {"id":"phrase-17","en":"Would you like some water?","zh":"你想喝点水吗？","scene":"家里和日常"},
  {"id":"phrase-18","en":"The washing machine is running.","zh":"洗衣机正在运转。","scene":"家里和日常"},
  {"id":"phrase-19","en":"I need to clean the kitchen.","zh":"我需要打扫厨房。","scene":"家里和日常"},
  {"id":"phrase-20","en":"Could you open the window?","zh":"你能把窗户打开吗？","scene":"家里和日常"},
  {"id":"phrase-21","en":"A table for two, please.","zh":"请安排一张两人桌。","scene":"吃饭和咖啡馆"},
  {"id":"phrase-22","en":"Could I see the menu?","zh":"我可以看一下菜单吗？","scene":"吃饭和咖啡馆"},
  {"id":"phrase-23","en":"I’d like a cup of tea.","zh":"我想要一杯茶。","scene":"吃饭和咖啡馆"},
  {"id":"phrase-24","en":"Could I have this without sugar?","zh":"这个可以不加糖吗？","scene":"吃饭和咖啡馆"},
  {"id":"phrase-25","en":"What do you recommend?","zh":"你有什么推荐？","scene":"吃饭和咖啡馆"},
  {"id":"phrase-26","en":"This is delicious.","zh":"这个很好吃。","scene":"吃饭和咖啡馆"},
  {"id":"phrase-27","en":"Could we have the bill, please?","zh":"麻烦结账。","scene":"吃饭和咖啡馆"},
  {"id":"phrase-28","en":"Can I have this to go?","zh":"这个可以打包吗？","scene":"吃饭和咖啡馆"},
  {"id":"phrase-29","en":"I’m allergic to peanuts.","zh":"我对花生过敏。","scene":"吃饭和咖啡馆"},
  {"id":"phrase-30","en":"Is this dish spicy?","zh":"这道菜辣吗？","scene":"吃饭和咖啡馆"},
  {"id":"phrase-31","en":"How much is this?","zh":"这个多少钱？","scene":"购物和办事"},
  {"id":"phrase-32","en":"Do you have a smaller size?","zh":"有小一点的尺码吗？","scene":"购物和办事"},
  {"id":"phrase-33","en":"Can I try this on?","zh":"我可以试穿吗？","scene":"购物和办事"},
  {"id":"phrase-34","en":"Where can I pay?","zh":"我在哪里付款？","scene":"购物和办事"},
  {"id":"phrase-35","en":"Can I pay by card?","zh":"我可以刷卡吗？","scene":"购物和办事"},
  {"id":"phrase-36","en":"Could I have a receipt?","zh":"可以给我收据吗？","scene":"购物和办事"},
  {"id":"phrase-37","en":"Is there a discount?","zh":"有折扣吗？","scene":"购物和办事"},
  {"id":"phrase-38","en":"I’m just looking, thank you.","zh":"我只是看看，谢谢。","scene":"购物和办事"},
  {"id":"phrase-39","en":"Could I exchange this?","zh":"我可以换这个吗？","scene":"购物和办事"},
  {"id":"phrase-40","en":"Do you have this in another colour?","zh":"这个有别的颜色吗？","scene":"购物和办事"},
  {"id":"phrase-41","en":"Where is the nearest bus stop?","zh":"最近的公交车站在哪里？","scene":"出行和问路"},
  {"id":"phrase-42","en":"Does this bus go to the city centre?","zh":"这辆公交车去市中心吗？","scene":"出行和问路"},
  {"id":"phrase-43","en":"Which platform does the train leave from?","zh":"火车从哪个站台出发？","scene":"出行和问路"},
  {"id":"phrase-44","en":"I’d like a one-way ticket.","zh":"我想买一张单程票。","scene":"出行和问路"},
  {"id":"phrase-45","en":"How long does it take?","zh":"需要多长时间？","scene":"出行和问路"},
  {"id":"phrase-46","en":"Could you show me on the map?","zh":"你能在地图上指给我看吗？","scene":"出行和问路"},
  {"id":"phrase-47","en":"Go straight and turn left.","zh":"直走然后左转。","scene":"出行和问路"},
  {"id":"phrase-48","en":"Is it within walking distance?","zh":"走路能到吗？","scene":"出行和问路"},
  {"id":"phrase-49","en":"I think we’ve missed our stop.","zh":"我觉得我们坐过站了。","scene":"出行和问路"},
  {"id":"phrase-50","en":"The train is delayed.","zh":"火车晚点了。","scene":"出行和问路"},
  {"id":"phrase-51","en":"I’d like to make an appointment.","zh":"我想预约。","scene":"健康和看病"},
  {"id":"phrase-52","en":"I have a headache.","zh":"我头痛。","scene":"健康和看病"},
  {"id":"phrase-53","en":"My throat is sore.","zh":"我喉咙痛。","scene":"健康和看病"},
  {"id":"phrase-54","en":"I have had a cough for three days.","zh":"我咳嗽三天了。","scene":"健康和看病"},
  {"id":"phrase-55","en":"Where is the nearest pharmacy?","zh":"最近的药店在哪里？","scene":"健康和看病"},
  {"id":"phrase-56","en":"How often should I take this medicine?","zh":"这个药应该多久吃一次？","scene":"健康和看病"},
  {"id":"phrase-57","en":"I’m feeling a little better.","zh":"我感觉好一点了。","scene":"健康和看病"},
  {"id":"phrase-58","en":"Could you write that down for me?","zh":"你能帮我写下来吗？","scene":"健康和看病"},
  {"id":"phrase-59","en":"I need to rest today.","zh":"我今天需要休息。","scene":"健康和看病"},
  {"id":"phrase-60","en":"Please call a doctor.","zh":"请叫医生。","scene":"健康和看病"},
  {"id":"phrase-61","en":"Would you like to join us?","zh":"你想和我们一起吗？","scene":"朋友和交流"},
  {"id":"phrase-62","en":"Thank you for inviting me.","zh":"谢谢你邀请我。","scene":"朋友和交流"},
  {"id":"phrase-63","en":"I’m afraid I can’t make it.","zh":"恐怕我去不了。","scene":"朋友和交流"},
  {"id":"phrase-64","en":"What have you been up to?","zh":"你最近在忙什么？","scene":"朋友和交流"},
  {"id":"phrase-65","en":"That sounds lovely.","zh":"听起来很不错。","scene":"朋友和交流"},
  {"id":"phrase-66","en":"I agree with you.","zh":"我同意你的看法。","scene":"朋友和交流"},
  {"id":"phrase-67","en":"Let me think about it.","zh":"让我想一想。","scene":"朋友和交流"},
  {"id":"phrase-68","en":"Could you help me with this?","zh":"你能帮我一下吗？","scene":"朋友和交流"},
  {"id":"phrase-69","en":"It was lovely talking to you.","zh":"很高兴和你聊天。","scene":"朋友和交流"},
  {"id":"phrase-70","en":"See you next time.","zh":"下次见。","scene":"朋友和交流"},
  {"id":"phrase-71","en":"I have a reservation under my name.","zh":"我用自己的名字预订了房间。","scene":"酒店和旅行"},
  {"id":"phrase-72","en":"What is the Wi-Fi password?","zh":"Wi-Fi 密码是多少？","scene":"酒店和旅行"},
  {"id":"phrase-73","en":"What time is check-out?","zh":"退房时间是几点？","scene":"酒店和旅行"},
  {"id":"phrase-74","en":"Could we leave our luggage here?","zh":"我们可以把行李寄存这里吗？","scene":"酒店和旅行"},
  {"id":"phrase-75","en":"Is breakfast included?","zh":"包含早餐吗？","scene":"酒店和旅行"},
  {"id":"phrase-76","en":"Could I have a quiet room, please?","zh":"可以给我安排一间安静的房间吗？","scene":"酒店和旅行"},
  {"id":"phrase-77","en":"My room key isn’t working.","zh":"我的房卡刷不开门。","scene":"酒店和旅行"},
  {"id":"phrase-78","en":"Could you call a taxi to the airport?","zh":"能帮我叫一辆去机场的出租车吗？","scene":"酒店和旅行"},
  {"id":"phrase-79","en":"Where is the boarding gate?","zh":"登机口在哪里？","scene":"酒店和旅行"},
  {"id":"phrase-80","en":"I’d like a window seat, please.","zh":"请给我一个靠窗的座位。","scene":"酒店和旅行"},
  {"id":"phrase-81","en":"Sorry, I’m running a few minutes late.","zh":"抱歉，我要晚到几分钟。","scene":"工作和邮件"},
  {"id":"phrase-82","en":"Could we reschedule our meeting?","zh":"我们可以把会议改期吗？","scene":"工作和邮件"},
  {"id":"phrase-83","en":"I’ll send you the file shortly.","zh":"我马上把文件发给你。","scene":"工作和邮件"},
  {"id":"phrase-84","en":"Can you see my screen?","zh":"你能看到我的屏幕吗？","scene":"工作和邮件"},
  {"id":"phrase-85","en":"Let me double-check the details.","zh":"我再核对一下细节。","scene":"工作和邮件"},
  {"id":"phrase-86","en":"When is the deadline?","zh":"截止日期是什么时候？","scene":"工作和邮件"},
  {"id":"phrase-87","en":"Just following up on my last email.","zh":"跟进一下我上一封邮件。","scene":"工作和邮件"},
  {"id":"phrase-88","en":"I’ll be out of the office tomorrow.","zh":"我明天不在办公室。","scene":"工作和邮件"},
  {"id":"phrase-89","en":"Thanks for your quick reply.","zh":"谢谢你这么快回复。","scene":"工作和邮件"},
  {"id":"phrase-90","en":"Let’s take a short break.","zh":"我们先休息一会儿吧。","scene":"工作和邮件"},
  {"id":"phrase-91","en":"Sorry, the signal is a bit weak.","zh":"不好意思，信号有点弱。","scene":"电话和办事"},
  {"id":"phrase-92","en":"Can I call you back in ten minutes?","zh":"我十分钟后给你回电话好吗？","scene":"电话和办事"},
  {"id":"phrase-93","en":"I’d like to send this parcel.","zh":"我想寄这个包裹。","scene":"电话和办事"},
  {"id":"phrase-94","en":"Do I need to fill out a form?","zh":"我需要填表格吗？","scene":"电话和办事"},
  {"id":"phrase-95","en":"Where should I sign?","zh":"我应该在哪里签名？","scene":"电话和办事"},
  {"id":"phrase-96","en":"Could I cancel my booking?","zh":"我可以取消预订吗？","scene":"电话和办事"},
  {"id":"phrase-97","en":"Is there a queue here?","zh":"这里需要排队吗？","scene":"电话和办事"},
  {"id":"phrase-98","en":"I’m here to pick up a package.","zh":"我来取一个包裹。","scene":"电话和办事"},
  {"id":"phrase-99","en":"Do you need to see my passport?","zh":"需要看我的护照吗？","scene":"电话和办事"},
  {"id":"phrase-100","en":"How many days will it take to arrive?","zh":"大概需要几天才能寄到？","scene":"电话和办事"},
  {"id":"phrase-101","en":"What lovely weather today!","zh":"今天天气真好！","scene":"天气和闲聊"},
  {"id":"phrase-102","en":"It looks like it’s going to rain.","zh":"看起来快要下雨了。","scene":"天气和闲聊"},
  {"id":"phrase-103","en":"It’s freezing outside today.","zh":"今天外面冷极了。","scene":"天气和闲聊"},
  {"id":"phrase-104","en":"How was your weekend?","zh":"你周末过得怎么样？","scene":"天气和闲聊"},
  {"id":"phrase-105","en":"Do you have any plans for the weekend?","zh":"你周末有什么安排吗？","scene":"天气和闲聊"},
  {"id":"phrase-106","en":"Long time no see!","zh":"好久不见！","scene":"天气和闲聊"},
  {"id":"phrase-107","en":"Have a safe trip home.","zh":"祝你一路平安到家。","scene":"天气和闲聊"},
  {"id":"phrase-108","en":"Congratulations on your good news!","zh":"恭喜你的好消息！","scene":"天气和闲聊"},
  {"id":"phrase-109","en":"I hope you feel better soon.","zh":"祝你早日康复。","scene":"天气和闲聊"},
  {"id":"phrase-110","en":"Take care and keep in touch.","zh":"保重，常联系。","scene":"天气和闲聊"},
  {"id":"phrase-111","en":"No worries, take your time.","zh":"没关系，慢慢来。","scene":"礼貌和表达"},
  {"id":"phrase-112","en":"That makes a lot of sense.","zh":"这很有道理。","scene":"礼貌和表达"},
  {"id":"phrase-113","en":"To be honest, I’m not sure.","zh":"老实说，我不太确定。","scene":"礼貌和表达"},
  {"id":"phrase-114","en":"It depends on the weather.","zh":"这要看天气情况。","scene":"礼貌和表达"},
  {"id":"phrase-115","en":"Sorry to bother you.","zh":"不好意思打扰你一下。","scene":"礼貌和表达"},
  {"id":"phrase-116","en":"Never mind, it doesn’t matter.","zh":"没关系，不要紧。","scene":"礼貌和表达"},
  {"id":"phrase-117","en":"What a pity!","zh":"真可惜！","scene":"礼貌和表达"},
  {"id":"phrase-118","en":"I really appreciate your help.","zh":"非常感谢你的帮助。","scene":"礼貌和表达"},
  {"id":"phrase-119","en":"That’s very kind of you.","zh":"你真是太贴心了。","scene":"礼貌和表达"},
  {"id":"phrase-120","en":"Good point, I hadn’t thought of that.","zh":"说得对，我之前没想到这一点。","scene":"礼貌和表达"},
  {"id":"phrase-121","en":"The Wi-Fi isn’t working properly.","zh":"Wi-Fi 连接不太正常。","scene":"居家和邻里"},
  {"id":"phrase-122","en":"The kitchen tap is leaking.","zh":"厨房的水龙头在漏水。","scene":"居家和邻里"},
  {"id":"phrase-123","en":"The power just went out.","zh":"刚刚停电了。","scene":"居家和邻里"},
  {"id":"phrase-124","en":"Could I borrow your phone charger?","zh":"可以借一下你的手机充电器吗？","scene":"居家和邻里"},
  {"id":"phrase-125","en":"Which bin is for recycling?","zh":"哪个垃圾桶是放可回收物的？","scene":"居家和邻里"},
  {"id":"phrase-126","en":"Could we turn down the heating a little?","zh":"我们可以把暖气调低一点吗？","scene":"居家和邻里"},
  {"id":"phrase-127","en":"I locked myself out of the house.","zh":"我把自己锁在门外了。","scene":"居家和邻里"},
  {"id":"phrase-128","en":"Could you keep an eye on my parcel?","zh":"能帮我留意一下我的快递吗？","scene":"居家和邻里"},
  {"id":"phrase-129","en":"The door lock is a bit stuck.","zh":"门锁有点卡住了。","scene":"居家和邻里"},
  {"id":"phrase-130","en":"Thanks for bringing in the post.","zh":"谢谢你帮忙把信件拿进来。","scene":"居家和邻里"},
  {"id":"phrase-131","en":"Excuse me, I’ve lost my wallet.","zh":"不好意思，我的钱包丢了。","scene":"应急和求助"},
  {"id":"phrase-132","en":"My phone battery is almost dead.","zh":"我的手机快没电了。","scene":"应急和求助"},
  {"id":"phrase-133","en":"Is there somewhere I can charge my phone?","zh":"这里有地方可以给手机充电吗？","scene":"应急和求助"},
  {"id":"phrase-134","en":"I missed my connecting flight.","zh":"我错过了转机航班。","scene":"应急和求助"},
  {"id":"phrase-135","en":"Where is the nearest police station?","zh":"最近的警察局在哪里？","scene":"应急和求助"},
  {"id":"phrase-136","en":"Could you help me contact the embassy?","zh":"你能帮我联系大使馆吗？","scene":"应急和求助"},
  {"id":"phrase-137","en":"I need someone who speaks Mandarin.","zh":"我需要一位会说中文的人帮忙。","scene":"应急和求助"},
  {"id":"phrase-138","en":"Is this area safe at night?","zh":"这一带晚上安全吗？","scene":"应急和求助"},
  {"id":"phrase-139","en":"I think I’m lost. Could you point me to the station?","zh":"我好像迷路了，能指一下去车站的方向吗？","scene":"应急和求助"},
  {"id":"phrase-140","en":"Thank you so much, you’ve been a huge help.","zh":"太感谢你了，帮了大忙。","scene":"应急和求助"}
]
