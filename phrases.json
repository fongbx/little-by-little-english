[{"id":"phrase-1","en":"Hello, how are you?","zh":"你好，你好吗？","scene":"朋友和交流"},{"id":"phrase-2","en":"I’m fine, thank you.","zh":"我很好，谢谢。","scene":"朋友和交流"},{"id":"phrase-3","en":"What is your name?","zh":"你叫什么名字？","scene":"朋友和交流"},{"id":"phrase-4","en":"My name is…","zh":"我叫……","scene":"朋友和交流"},{"id":"phrase-5","en":"Nice to meet you.","zh":"很高兴认识你。","scene":"朋友和交流"},{"id":"phrase-6","en":"Where are you from?","zh":"你来自哪里？","scene":"朋友和交流"},{"id":"phrase-7","en":"I’m from China.","zh":"我来自中国。","scene":"朋友和交流"},{"id":"phrase-8","en":"Could you speak more slowly?","zh":"你能说慢一点吗？","scene":"朋友和交流"},{"id":"phrase-9","en":"Could you say that again?","zh":"你能再说一遍吗？","scene":"朋友和交流"},{"id":"phrase-10","en":"I don’t understand.","zh":"我不明白。","scene":"朋友和交流"},{"id":"phrase-11","en":"I’m at home.","zh":"我在家。","scene":"家里和日常"},{"id":"phrase-12","en":"Please come in.","zh":"请进。","scene":"家里和日常"},{"id":"phrase-13","en":"Make yourself at home.","zh":"别客气，就当在自己家。","scene":"家里和日常"},{"id":"phrase-14","en":"Where is the bathroom?","zh":"卫生间在哪里？","scene":"家里和日常"},{"id":"phrase-15","en":"Please take off your shoes.","zh":"请脱鞋。","scene":"家里和日常"},{"id":"phrase-16","en":"I’ll make some tea.","zh":"我来泡点茶。","scene":"家里和日常"},{"id":"phrase-17","en":"Would you like some water?","zh":"你想喝点水吗？","scene":"家里和日常"},{"id":"phrase-18","en":"The washing machine is running.","zh":"洗衣机正在运转。","scene":"家里和日常"},{"id":"phrase-19","en":"I need to clean the kitchen.","zh":"我需要打扫厨房。","scene":"家里和日常"},{"id":"phrase-20","en":"Could you open the window?","zh":"你能把窗户打开吗？","scene":"家里和日常"},{"id":"phrase-21","en":"A table for two, please.","zh":"请安排一张两人桌。","scene":"吃饭和咖啡馆"},{"id":"phrase-22","en":"Could I see the menu?","zh":"我可以看一下菜单吗？","scene":"吃饭和咖啡馆"},{"id":"phrase-23","en":"I’d like a cup of tea.","zh":"我想要一杯茶。","scene":"吃饭和咖啡馆"},{"id":"phrase-24","en":"Could I have this without sugar?","zh":"这个可以不加糖吗？","scene":"吃饭和咖啡馆"},{"id":"phrase-25","en":"What do you recommend?","zh":"你有什么推荐？","scene":"吃饭和咖啡馆"},{"id":"phrase-26","en":"This is delicious.","zh":"这个很好吃。","scene":"吃饭和咖啡馆"},{"id":"phrase-27","en":"Could we have the bill, please?","zh":"麻烦结账。","scene":"吃饭和咖啡馆"},{"id":"phrase-28","en":"Can I have this to go?","zh":"这个可以打包吗？","scene":"吃饭和咖啡馆"},{"id":"phrase-29","en":"I’m allergic to peanuts.","zh":"我对花生过敏。","scene":"吃饭和咖啡馆"},{"id":"phrase-30","en":"Is this dish spicy?","zh":"这道菜辣吗？","scene":"吃饭和咖啡馆"},{"id":"phrase-31","en":"How much is this?","zh":"这个多少钱？","scene":"购物和办事"},{"id":"phrase-32","en":"Do you have a smaller size?","zh":"有小一点的尺码吗？","scene":"购物和办事"},{"id":"phrase-33","en":"Can I try this on?","zh":"我可以试穿吗？","scene":"购物和办事"},{"id":"phrase-34","en":"Where can I pay?","zh":"我在哪里付款？","scene":"购物和办事"},{"id":"phrase-35","en":"Can I pay by card?","zh":"我可以刷卡吗？","scene":"购物和办事"},{"id":"phrase-36","en":"Could I have a receipt?","zh":"可以给我收据吗？","scene":"购物和办事"},{"id":"phrase-37","en":"Is there a discount?","zh":"有折扣吗？","scene":"购物和办事"},{"id":"phrase-38","en":"I’m just looking, thank you.","zh":"我只是看看，谢谢。","scene":"购物和办事"},{"id":"phrase-39","en":"Could I exchange this?","zh":"我可以换这个吗？","scene":"购物和办事"},{"id":"phrase-40","en":"Do you have this in another colour?","zh":"这个有别的颜色吗？","scene":"购物和办事"},{"id":"phrase-41","en":"Where is the nearest bus stop?","zh":"最近的公交车站在哪里？","scene":"出行和问路"},{"id":"phrase-42","en":"Does this bus go to the city centre?","zh":"这辆公交车去市中心吗？","scene":"出行和问路"},{"id":"phrase-43","en":"Which platform does the train leave from?","zh":"火车从哪个站台出发？","scene":"出行和问路"},{"id":"phrase-44","en":"I’d like a one-way ticket.","zh":"我想买一张单程票。","scene":"出行和问路"},{"id":"phrase-45","en":"How long does it take?","zh":"需要多长时间？","scene":"出行和问路"},{"id":"phrase-46","en":"Could you show me on the map?","zh":"你能在地图上指给我看吗？","scene":"出行和问路"},{"id":"phrase-47","en":"Go straight and turn left.","zh":"直走然后左转。","scene":"出行和问路"},{"id":"phrase-48","en":"Is it within walking distance?","zh":"走路能到吗？","scene":"出行和问路"},{"id":"phrase-49","en":"I think we’ve missed our stop.","zh":"我觉得我们坐过站了。","scene":"出行和问路"},{"id":"phrase-50","en":"The train is delayed.","zh":"火车晚点了。","scene":"出行和问路"},{"id":"phrase-51","en":"I’d like to make an appointment.","zh":"我想预约。","scene":"健康和看病"},{"id":"phrase-52","en":"I have a headache.","zh":"我头痛。","scene":"健康和看病"},{"id":"phrase-53","en":"My throat is sore.","zh":"我喉咙痛。","scene":"健康和看病"},{"id":"phrase-54","en":"I have had a cough for three days.","zh":"我咳嗽三天了。","scene":"健康和看病"},{"id":"phrase-55","en":"Where is the nearest pharmacy?","zh":"最近的药店在哪里？","scene":"健康和看病"},{"id":"phrase-56","en":"How often should I take this medicine?","zh":"这个药应该多久吃一次？","scene":"健康和看病"},{"id":"phrase-57","en":"I’m feeling a little better.","zh":"我感觉好一点了。","scene":"健康和看病"},{"id":"phrase-58","en":"Could you write that down for me?","zh":"你能帮我写下来吗？","scene":"健康和看病"},{"id":"phrase-59","en":"I need to rest today.","zh":"我今天需要休息。","scene":"健康和看病"},{"id":"phrase-60","en":"Please call a doctor.","zh":"请叫医生。","scene":"健康和看病"},{"id":"phrase-61","en":"Would you like to join us?","zh":"你想和我们一起吗？","scene":"朋友和交流"},{"id":"phrase-62","en":"Thank you for inviting me.","zh":"谢谢你邀请我。","scene":"朋友和交流"},{"id":"phrase-63","en":"I’m afraid I can’t make it.","zh":"恐怕我去不了。","scene":"朋友和交流"},{"id":"phrase-64","en":"What have you been up to?","zh":"你最近在忙什么？","scene":"朋友和交流"},{"id":"phrase-65","en":"That sounds lovely.","zh":"听起来很不错。","scene":"朋友和交流"},{"id":"phrase-66","en":"I agree with you.","zh":"我同意你的看法。","scene":"朋友和交流"},{"id":"phrase-67","en":"Let me think about it.","zh":"让我想一想。","scene":"朋友和交流"},{"id":"phrase-68","en":"Could you help me with this?","zh":"你能帮我一下吗？","scene":"朋友和交流"},{"id":"phrase-69","en":"It was lovely talking to you.","zh":"很高兴和你聊天。","scene":"朋友和交流"},{"id":"phrase-70","en":"See you next time.","zh":"下次见。","scene":"朋友和交流"}]